<!DOCTYPE html>
<html>
<head>
  <base target="_top">

  <meta name="viewport"
        content="width=device-width, initial-scale=1">

  <title>Registro de asistentes</title>

  <script src="https://unpkg.com/html5-qrcode"
          type="text/javascript"></script>

  <style>

    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 20px;
      background: #f5f5f5;
      text-align: center;
    }

    h1 {
      font-size: 24px;
      margin-bottom: 10px;
    }

    #estado {
      margin: 15px 0;
      font-size: 18px;
      font-weight: bold;
    }

    #reader {
      max-width: 500px;
      margin: 0 auto;
      background: white;
      border-radius: 12px;
      padding: 10px;
    }

    #resultado {
      max-width: 500px;
      margin: 20px auto;
      padding: 20px;
      background: white;
      border-radius: 12px;
      display: none;
    }

    #nombre {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 10px;
    }

    #hora {
      font-size: 20px;
    }

    .exito {
      color: #16803c;
    }

    .error {
      color: #b42318;
    }

  </style>
</head>

<body>

  <h1>Registro de asistentes</h1>

  <div id="estado">
    Preparando cámara...
  </div>

  <div id="reader"></div>

  <div id="resultado">

    <div id="nombre"></div>

    <div id="hora"></div>

  </div>


  <script>

    let procesando = false;

    const estado = document.getElementById('estado');
    const nombreElemento = document.getElementById('nombre');
    const horaElemento = document.getElementById('hora');
    const resultado = document.getElementById('resultado');


    function mostrarExito(datos) {

      estado.textContent = '✓ Registro exitoso';
      estado.className = 'exito';

      nombreElemento.textContent = datos.nombre;

      horaElemento.textContent =
        datos.fecha + ' — ' + datos.hora;

      resultado.style.display = 'block';

      // Vibración si el teléfono lo permite
      if (navigator.vibrate) {
        navigator.vibrate(150);
      }

      // Sonido corto de confirmación
      reproducirSonido();

      // Después de un momento queda listo
      // para el siguiente QR.
      setTimeout(() => {

        resultado.style.display = 'none';

        estado.textContent = 'Listo para escanear';

        procesando = false;

      }, 1200);
    }


    function mostrarError(mensaje) {

      estado.textContent = '⚠ ' + mensaje;
      estado.className = 'error';

      procesando = false;

    }


    function reproducirSonido() {

      try {

        const contexto =
          new (window.AudioContext ||
               window.webkitAudioContext)();

        const oscilador =
          contexto.createOscillator();

        const ganancia =
          contexto.createGain();

        oscilador.frequency.value = 880;

        ganancia.gain.value = 0.08;

        oscilador.connect(ganancia);

        ganancia.connect(contexto.destination);

        oscilador.start();

        oscilador.stop(
          contexto.currentTime + 0.12
        );

      } catch (e) {

        // Si el navegador no permite sonido,
        // simplemente continuamos.
      }
    }


    function onScanSuccess(decodedText) {

      if (procesando) {
        return;
      }

      procesando = true;

      estado.textContent = 'Registrando...';

      google.script.run

        .withSuccessHandler(mostrarExito)

        .withFailureHandler(function(error) {

          mostrarError(
            error.message || 'No se pudo registrar.'
          );

        })

        .registrarAsistente(decodedText);
    }


    function onScanFailure(error) {
      // No hacemos nada.
      // El escáner seguirá buscando un QR.
    }


    const scanner =
      new Html5QrcodeScanner(
        'reader',
        {
          fps: 10,
          qrbox: {
            width: 250,
            height: 250
          }
        },
        false
      );


    scanner.render(
      onScanSuccess,
      onScanFailure
    );


    estado.textContent =
      'Listo para escanear';

  </script>

</body>
</html>
